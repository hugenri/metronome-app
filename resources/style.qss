QMainWindow, QWidget {
    background: #0b0f14;
    color: #f5f7fa;
    font-family: "Segoe UI";
}

QLabel#brand {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: 5px;
}

QLabel#subtitle {
    color: #7f8b9b;
    font-size: 15px;
    letter-spacing: 2px;
}

QLabel#tagline {
    color: #9ca7b6;
    font-size: 15px;
}

QFrame#card {
    background: #10161e;
    border: 1px solid #24303e;
    border-radius: 18px;
}

QLabel#section {
    color: #aeb8c7;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#bpm {
    font-size: 24px;
    font-weight: 800;
}

QLabel#beatNumber {
    font-size: 62px;
    font-weight: 800;
}

QLabel#percent {
    color: #aeb8c7;
    font-size: 15px;
}

QPushButton {
    min-height: 44px;
    border-radius: 12px;
    border: 1px solid #2c3948;
    background: #151d27;
    color: #f5f7fa;
    font-size: 14px;
    font-weight: 700;
}

QPushButton:hover {
    background: #1b2733;
}

QPushButton#start {
    background: #18c99a;
    border: none;
    color: #06130f;
    font-size: 17px;
}

QPushButton#start:hover {
    background: #25ddb0;
}

QPushButton#stop {
    background: #151d27;
}

QPushButton#tempoButton {
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    border-radius: 12px;
    font-size: 22px;
    background: #12202a;
    border: 1px solid #234254;
}

QComboBox, QSpinBox {
    min-height: 36px;
    background: #10161e;
    border: 1px solid #293746;
    border-radius: 10px;
    padding: 0 10px;
    font-size: 14px;
}

QComboBox::drop-down {
    border: none;
    width: 34px;
}

QSlider::groove:horizontal {
    height: 7px;
    background: #263241;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #12bfe9;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
    background: #f5f7fa;
}

QLabel#step {
    font-size: 12px;
    color: #7f8b9b;
    min-width: 24px;
}

QLabel#step.active {
    color: #12c9ef;
    font-weight: 800;
}

QLabel#step.accent {
    color: #ffffff;
    font-weight: 900;
}

QFrame#beatRing {
    background: #1a2a35;
    border: 2px solid #21495c;
    border-radius: 90px;
}

QFrame#beatRing.active {
    background: #164052;
    border: 3px solid #12c9ef;
    border-radius: 110px;
}

QFrame#beatRing.accent {
    background: #205b68;
    border: 4px solid #55dcff;
    border-radius: 110px;
}
